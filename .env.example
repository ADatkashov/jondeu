# Copy to .env — never commit real values.
DB_USER=jondeu
DB_PASSWORD=change-me
# >= 32 characters, random. Used to sign JWTs and media URLs.
JWT_SECRET=change-me-change-me-change-me-change-me
SPRING_PROFILES_ACTIVE=dev        # use "prod" in production (sandbox payments, demo data and dev OTP are OFF)
DEMO_ENABLED=true                 # demo data + demo accounts; NEVER true in production
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
# Payments (leave empty until real credentials exist — nothing is faked without them)
SANDBOX_PAYMENT_SECRET=
KASPI_MERCHANT_ID=
KASPI_API_KEY=
